# ════════════════════════════════════════════════════════════════════
#  backend/.env  — the ONLY file where keys go. Copy this file to ".env"
#  and paste your keys after the "=" (no quotes, no spaces).
#  The frontend needs no key file: it gets the browser key from the backend.
# ════════════════════════════════════════════════════════════════════

# ── 1. AI (NVIDIA) — required for: AI briefings, news agent, flood photo reading, web photo agent
#    Check which models your key can use:  python -m scripts.check_keys
#    (meta/llama-3.3-70b-instruct was retired on 2026-08-26; the 90b vision model is often overloaded)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# Tried in order when the main model fails or times out (comma separated, optional)
LLM_FALLBACK_MODELS=meta/llama-3.2-11b-vision-instruct,mistralai/mistral-nemotron
VISION_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,meta/llama-3.2-90b-vision-instruct
LLM_TIMEOUT_S=25

# ── 2. Google Maps Platform — required for: Google 3D map, Places, search, photos, routes, addresses
#    The SERVER key is also used for Cloud Translation (UI in any language) and Cloud Text-to-Speech
#    (emergency card read aloud). Enable both APIs in the same Google Cloud project and allow them
#    in the key's "API restrictions". Without them: built-in en/fr/ar texts + the phone's own voice.
GOOGLE_BROWSER_KEY=
GOOGLE_SERVER_KEY=
GOOGLE_MAP_ID=

# ── 3. NASA FIRMS — required for: satellite fire detection
FIRMS_MAP_KEY=

# ── 4. Web flood-photo agent
YOUTUBE_API_KEY=
FLICKR_API_KEY=
WEB_MAX_AGE_H=24

# ── App settings (leave as is)
COUNTRY=TN
COLLECT_EVERY_MIN=5

# ── Testing tools
# DEV_MODE=1 shows the "Under the hood" panel (traces + simulation lab) in the app.
# ADMIN_TOKEN: when set, demo/simulation/admin endpoints require header X-Admin-Token
# (the frontend sends VITE_ADMIN_TOKEN from frontend/.env.local).
# Before any public deploy: DEV_MODE=0 and set ADMIN_TOKEN.
DEV_MODE=1
# DEMO_MODE=1 keeps only the simulation panel (use DEV_MODE=0 + DEMO_MODE=1 in production)
DEMO_MODE=1
ADMIN_TOKEN=
